# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o arquivo ".env" (ja esta no .gitignore).

# "development" (padrao) ou "production". Em producao, o app recusa subir
# se JWT_SECRET_KEY ainda estiver no valor padrao deste arquivo (ver
# core/config.py:validar_configuracao_producao) -- gere uma chave real
# antes de fazer deploy (Railway/Vercel, ver README secao "Deploy").
ENVIRONMENT=development

# String de conexao com o PostgreSQL da loja (hoje: Neon, serverless free tier).
# Formato: postgresql+psycopg://usuario:senha@host/nome_do_banco?sslmode=require
# Se DATABASE_URL ficar vazio, o backend usa um arquivo SQLite local (ver
# core/config.py) para permitir rodar e testar sem depender do Postgres.
DATABASE_URL=

# Chave secreta para assinatura dos tokens JWT do login de funcionario.
# Gere uma string aleatoria longa, ex: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Origens permitidas para CORS (frontend), separadas por virgula. Em
# producao, troque para a URL real do frontend no Vercel (ex.:
# https://seu-projeto.vercel.app) -- nao deixe localhost em producao.
CORS_ORIGINS=http://localhost:5173

# Chaves dos provedores de IA gratuitos (Fase 4).
# Groq (primario, gratuito): https://console.groq.com -> API Keys
# Gemini (fallback, gratuito): https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Guard-rails de preco (ver backend/app/services/price_service.py).
# Nenhuma promocao -- nem sugerida pela IA, nem aprovada por funcionario --
# pode deixar o preco abaixo de custo * (1 + MARGEM_MINIMA_PERCENTUAL/100).
# E o que impede o sistema de colocar um produto a venda no prejuizo.
MARGEM_MINIMA_PERCENTUAL=10
DESCONTO_MAXIMO_PERCENTUAL=70
# "true" deixa promover produto sem custo cadastrado (nem todo custo esta
# lancado na loja); "false" recusa, postura mais conservadora.
PERMITIR_PROMOCAO_SEM_CUSTO=true
# Divergencia maxima, em pontos percentuais do preco normal, entre o
# percentual de desconto e o preco que o LLM devolve no mesmo JSON.
TOLERANCIA_COERENCIA_PP=2
# Informa o teto de desconto dentro do proprio prompt. Vira braco de A/B
# no harness de avaliacao (backend/scripts/avaliar_llm.py).
INFORMAR_PISO_NO_PROMPT=true

# "true" enquanto os dados de venda/promocao vierem do seed simulado
# (app/seed.py) e nao da operacao real da loja -- liga o aviso na tela de
# indicadores. Trocar para "false" quando a loja passar a usar de verdade.
DADOS_SIMULADOS=true

# Job periodico de limpeza: expira promocoes vencidas e pedidos
# abandonados. Nao gera sugestoes -- a geracao roda so quando o
# funcionario clica em "Gerar sugestoes agora". Deixe "false" em
# dev/teste -- so ligue em producao (a app precisa ficar de pe
# continuamente pro APScheduler funcionar).
ENABLE_SCHEDULER=false

# Intervalo (segundos) que os displays fisicos de prateleira devem esperar
# entre uma sincronizacao e outra -- devolvido a cada resposta de
# POST /displays/sincronizar, entao da pra ajustar sem reflashear os
# dispositivos (ver docs/displays-fisicos.md). Default: 300 (5 min).
# So vale pra variante e-paper + polling (producao).
DISPLAY_SYNC_INTERVALO_SEGUNDOS=300

# Push MQTT pros displays (variante OLED de demonstracao -- atualizacao
# instantanea quando uma promocao e aprovada). Ver docs/displays-fisicos.md.
#
# Deixe "false" em dev/CI: sem broker o sistema funciona igual, so nao ha
# push (o display da variante de producao continua pegando o preco novo no
# proximo polling). O push e best-effort: falha de broker NUNCA derruba a
# aprovacao da promocao.
MQTT_ENABLED=false
# Host do broker. Gratuito e suficiente pro TCC: HiveMQ Cloud
# (https://console.hivemq.cloud) ou um mosquitto local na LAN da loja.
MQTT_HOST=
# 8883 = TLS (broker gerenciado). 1883 = sem TLS (mosquitto local).
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
# Topico publicado por display: {prefixo}/{display_id}/preco
MQTT_TOPIC_PREFIX=loja/displays
